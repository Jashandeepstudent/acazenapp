#!/bin/sh
#
# Gradle wrapper script.
# Uses gradle/wrapper/gradle-wrapper.jar when it is present. Otherwise it downloads the
# Gradle version named in gradle/wrapper/gradle-wrapper.properties on first run and uses that.
# Run "./gradlew wrapper" once to generate the standard wrapper jar.

# Resolve the real location of this script (follows symlinks)
app_path=$0
while [ -h "$app_path" ]; do
    ls=$(ls -ld "$app_path")
    link=${ls#*' -> '}
    case $link in
        /*) app_path=$link ;;
        *) app_path=$(dirname "$app_path")/$link ;;
    esac
done
APP_HOME=$(cd "$(dirname "$app_path")" >/dev/null && pwd -P) || exit 1
PROPS="$APP_HOME/gradle/wrapper/gradle-wrapper.properties"
JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

if [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/java" ]; then
    JAVACMD=$JAVA_HOME/bin/java
else
    JAVACMD=java
fi
if ! command -v "$JAVACMD" >/dev/null 2>&1; then
    echo "ERROR: Java was not found. Install JDK 17 or newer, or set JAVA_HOME." >&2
    exit 1
fi

# Standard wrapper
if [ -f "$JAR" ]; then
    exec "$JAVACMD" -Dorg.gradle.appname=gradlew -classpath "$JAR" org.gradle.wrapper.GradleWrapperMain "$@"
fi

# No jar: download the Gradle distribution from gradle-wrapper.properties
URL=$(sed -n 's/^distributionUrl=//p' "$PROPS" | tr -d '\\\r')
if [ -z "$URL" ]; then
    echo "ERROR: distributionUrl not found in $PROPS" >&2
    exit 1
fi
NAME=${URL##*/}
NAME=${NAME%.zip}
VER=${NAME#gradle-}
VER=${VER%-bin}
VER=${VER%-all}
DEST="${GRADLE_USER_HOME:-$HOME/.gradle}/wrapper/bootstrap/$NAME"
GRADLE_BIN="$DEST/gradle-$VER/bin/gradle"

if [ ! -x "$GRADLE_BIN" ]; then
    echo "Downloading $URL" >&2
    mkdir -p "$DEST" || exit 1
    ZIP="$DEST/$NAME.zip"
    if command -v curl >/dev/null 2>&1; then
        curl -fL --retry 3 -o "$ZIP" "$URL" || exit 1
    elif command -v wget >/dev/null 2>&1; then
        wget -O "$ZIP" "$URL" || exit 1
    else
        echo "ERROR: curl or wget is required to download Gradle." >&2
        exit 1
    fi
    if command -v unzip >/dev/null 2>&1; then
        unzip -q -o "$ZIP" -d "$DEST" || exit 1
    else
        python3 -m zipfile -e "$ZIP" "$DEST" || exit 1
    fi
    rm -f "$ZIP"
    chmod +x "$GRADLE_BIN"
fi

exec "$GRADLE_BIN" "$@"
