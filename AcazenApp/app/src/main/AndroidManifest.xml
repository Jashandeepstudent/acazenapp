<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Double-press Power voice shortcut: the overlay dictates with the mic, and needs to
         light the screen and draw over the keyguard when summoned from sleep. The always-on
         "Hey Acazen" wake word was REMOVED (no FOREGROUND_SERVICE_MICROPHONE, no boot receiver,
         no Vosk model) — the gesture-based path costs zero battery. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Lets the voice overlay dismiss an INSECURE keyguard (pattern/PIN-less) after the
         double-press wakes the phone; secure locks still require the user's own unlock. -->
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:name=".AcazenApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Acazen">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <!-- The dedicated double-press-Power page: Safari-style "Listening…" overlay that
             shows what the user says and AUTO-SENDS it to Acazen. Draws over the keyguard and
             lights the screen; excluded from Recents so it's a pure transient overlay. -->
        <!-- THE dedicated setup page for the double-press Power shortcut: animated 3-step
             checklist (mic -> accessibility -> live test), honest state read from system
             settings, and OEM troubleshooting guidance. Opened from the website sheet toggle. -->
        <activity
            android:name=".DoublePressSettingsActivity"
            android:exported="false"
            android:label="Double-press Power"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Acazen" />

        <activity
            android:name=".VoiceCommandActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.Acazen.VoiceOverlay" />

        <!-- Watches for a global double-press of the Power button (the only sanctioned way a
             normal app can see hardware keys system-wide). User enables it once via Settings >
             Accessibility; the app's toggle deep-links straight there. -->
        <service
            android:name=".DoublePressPowerService"
            android:exported="true"
            android:label="Acazen — Double-press Power"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_double_press" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>


    </application>
</manifest>
