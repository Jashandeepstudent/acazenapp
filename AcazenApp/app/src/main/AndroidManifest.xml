<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Hold-Power voice shortcut: Acazen registers as the device's Digital Assistant app
         (RoleManager.ROLE_ASSISTANT, requested from AssistantSetupActivity) so the SYSTEM
         itself routes its native hold-Power-for-assistant gesture to AcazenInteractionSession,
         which dictates with the mic and needs to light the screen / draw over the keyguard when
         summoned from sleep. No always-on microphone, no boot receiver, no on-device wake-word
         model — nothing runs until the gesture fires, so this costs zero background battery. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".AcazenApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Acazen">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <!-- THE dedicated setup page for the hold-Power Assistant shortcut: animated 3-step
             checklist (mic -> make Acazen the Assistant -> live test), honest state read fresh
             from RoleManager every time, and OEM troubleshooting guidance. Opened from the
             website sheet toggle. -->
        <activity
            android:name=".AssistantSetupActivity"
            android:exported="false"
            android:label="Hold Power for Acazen"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Acazen" />

        <!-- Rehearsal-mode overlay only now ("Try it" on the setup page). The real gesture no
             longer launches this Activity directly — see its class doc comment. -->
        <activity
            android:name=".VoiceCommandActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.Acazen.VoiceOverlay" />

        <!-- Makes Acazen eligible for, and (once the user grants it) the live holder of,
             RoleManager.ROLE_ASSISTANT — the system setting that routes its native
             hold-Power-button gesture (and long-press-Home / assist-swipe on devices that have
             one) to AcazenInteractionSession. See AcazenInteractionService's doc comment for
             the full explanation of why this replaced the old accessibility-service approach. -->
        <service
            android:name=".AcazenInteractionService"
            android:exported="true"
            android:label="Acazen"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:process=":interactor">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/acazen_voice_interaction_service" />
        </service>

        <service
            android:name=".AcazenInteractionSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:process=":interactor" />

        <!-- Required for ROLE_ASSISTANT eligibility; performs no recognition work itself — see
             AcazenRecognitionService's doc comment. -->
        <service
            android:name=".AcazenRecognitionService"
            android:exported="true"
            android:label="Acazen">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/acazen_recognition_service" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>


    </application>
</manifest>
