<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Hold-Power voice shortcut: Acazen registers as the device's Digital Assistant app
         (RoleManager.ROLE_ASSISTANT, requested from AssistantSetupActivity) so the SYSTEM
         itself routes its native hold-Power-for-assistant gesture to AcazenInteractionSession -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Android 11+ hides other apps by default. Naming the speech-recognition service interface
         lets Recognizers find the phone's real recognizer (Google, Samsung, …) so the listening
         screen and the website's voice mode can use it. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- Step 3 of setup (AssistantSetupActivity.openBrandSettings) resolves specific
             com.android.settings activities to deep-link straight into the phone's own
             "hold Power for Assistant" screen. com.android.settings is a system package and is
             normally visible regardless, but naming it here keeps that resolveActivity() check
             reliable on OEM builds that don't treat system packages as exempt. -->
        <package android:name="com.android.settings" />
    </queries>

    <application
        android:name=".AcazenApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Acazen">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AssistantSetupActivity"
            android:exported="false"
            android:label="Hold Power for Acazen"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Acazen" />

        <!-- FIX: exported=true + ASSIST filter is required for ROLE_ASSISTANT eligibility.
             Without this, RoleManager request silently returns RESULT_CANCELED. -->
        <activity
            android:name=".VoiceCommandActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.Acazen.VoiceOverlay">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".AcazenInteractionService"
            android:exported="true"
            android:label="Acazen"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:process=":interactor">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/acazen_voice_interaction_service" />
        </service>

        <service
            android:name=".AcazenInteractionSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:process=":interactor" />

        <service
            android:name=".AcazenRecognitionService"
            android:exported="true"
            android:label="Acazen">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/acazen_recognition_service" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
