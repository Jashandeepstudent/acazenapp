<?xml version="1.0" encoding="utf-8"?>
<!-- Special frame around the logo on the opening screen:
     a rounded gradient border (brand blue -> sky -> gold) with a white mat inside. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="@color/brand"
                android:centerColor="@color/logo_frame_sky"
                android:endColor="@color/logo_frame_gold" />
            <corners android:radius="44dp" />
        </shape>
    </item>
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="40dp" />
        </shape>
    </item>
</layer-list>
