<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded "window" the logo picture is clipped to (its fill matches the logo's own
     background so the rounded corners blend in). Corner radius = frame radius minus the frame padding. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/icon_bg" />
    <corners android:radius="34dp" />
</shape>
