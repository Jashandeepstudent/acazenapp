<resources>
    <!-- Dark-mode equivalents of the light palette in values/colors.xml.
         Keeps the same brand hue but darkens backgrounds so the splash,
         app icon background and WebView container all agree with each
         other instead of mixing light-blue UI with a system-dark
         background. -->
    <color name="brand">#7FB3F2</color>
    <color name="splash_bg">#0E1A2B</color>
    <color name="icon_bg">#11203A</color>
    <color name="app_background">#0B1420</color>
</resources>
